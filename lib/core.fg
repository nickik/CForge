module core;

// Mirror of Forge's freestanding standard-library root.
// CForge uses this file to develop multi-unit/module resolution and library
// contract testing.
//
// Explicit durable-allocation rule: ordinary values and collections do not
// retain Allocator capabilities. Any operation that allocates, resizes, clones
// owning storage, or frees durable storage receives the allocator explicitly at
// the call site. Memory-domain managers such as Arena/ObjectCache may retain
// lower-level provider capabilities because managing memory is their purpose.

pub enum PanicKind {
    Explicit,
    Assertion,
    Bounds,
    IntegerOverflow,
    DivideByZero,
    InvalidShift,
    Unreachable,
    AllocationFailure,
}

pub struct PanicLocation {
    file: str;
    line: u32;
    column: u32;
}

pub struct PanicInfo {
    kind: PanicKind;
    message: str;
    location: PanicLocation?;
}

// The final environment supplies exactly one non-returning panic provider:
//   __forge_panic(info: &PanicInfo) -> never

pub enum AllocError {
    OutOfMemory,
    InvalidSize,
    InvalidAlignment,
    ResourceLimit,
    ForeignAllocation,
    CorruptState,
}

pub enum AllocWait {
    MayWait,
    NoWait,
}

pub struct AllocRequest {
    size: usize;
    align: usize;
    wait: AllocWait;
}

pub struct MemoryBlock {
    data: *byte;
    size: usize;
    align: usize;
}

pub struct ArenaOps {
    alloc: fn(*void, AllocRequest) -> Result[MemoryBlock, AllocError];
    free: fn(*void, MemoryBlock) -> void;
    reclaim: fn(*void, usize) -> usize;
}

pub struct Arena {
    context: *void;
    ops: &ArenaOps;
}

pub fn arena_alloc(
    arena: &mut Arena,
    request: AllocRequest
) -> Result[MemoryBlock, AllocError] {
    return arena.ops.alloc(arena.context, request);
}

pub fn arena_free(arena: &mut Arena, block: MemoryBlock) -> void {
    arena.ops.free(arena.context, block);
}

pub fn arena_reclaim(arena: &mut Arena, target_bytes: usize) -> usize {
    return arena.ops.reclaim(arena.context, target_bytes);
}

pub struct AllocatorOps {
    alloc: fn(*void, AllocRequest) -> Result[MemoryBlock, AllocError];
    free: fn(*void, MemoryBlock) -> Result[void, AllocError];
    resize: fn(*void, MemoryBlock, usize) -> Result[MemoryBlock, AllocError];
}

pub struct Allocator {
    context: *void;
    ops: &AllocatorOps;
}

pub fn allocator_alloc(
    allocator: &mut Allocator,
    request: AllocRequest
) -> Result[MemoryBlock, AllocError] {
    return allocator.ops.alloc(allocator.context, request);
}

pub fn allocator_free(
    allocator: &mut Allocator,
    block: MemoryBlock
) -> Result[void, AllocError] {
    return allocator.ops.free(allocator.context, block);
}

pub fn allocator_resize(
    allocator: &mut Allocator,
    block: MemoryBlock,
    new_size: usize
) -> Result[MemoryBlock, AllocError] {
    return allocator.ops.resize(allocator.context, block, new_size);
}

pub struct ObjectCacheSpec {
    object_size: usize;
    object_align: usize;
    slab_size: usize;
}

pub struct ObjectCacheStats {
    allocations: u64;
    frees: u64;
    allocation_failures: u64;
    objects_in_use: usize;
    objects_free: usize;
    slabs_total: usize;
    slabs_empty: usize;
    bytes_backing: usize;
    reclaims: u64;
}

pub struct ObjectCache {
    arena: &mut Arena;
    spec: ObjectCacheSpec;
}

pub fn min_i32(a: i32, b: i32) -> i32 {
    if (a < b) { return a; }
    return b;
}

pub fn max_i32(a: i32, b: i32) -> i32 {
    if (a > b) { return a; }
    return b;
}

pub fn min_u32(a: u32, b: u32) -> u32 {
    if (a < b) { return a; }
    return b;
}

pub fn max_u32(a: u32, b: u32) -> u32 {
    if (a > b) { return a; }
    return b;
}

pub fn is_power_of_two_usize(value: usize) -> bool {
    if (value == 0) { return false; }
    return (value & (value - 1)) == 0;
}

pub fn valid_alignment(align: usize) -> bool {
    return is_power_of_two_usize(align);
}

pub fn align_up_usize(value: usize, align: usize) -> usize {
    return (value + (align - 1)) & ~(align - 1);
}

pub fn valid_alloc_request(request: &AllocRequest) -> bool {
    if (request.size == 0) { return false; }
    return valid_alignment(request.align);
}

pub fn valid_object_cache_spec(spec: &ObjectCacheSpec) -> bool {
    if (spec.object_size == 0) { return false; }
    if (!valid_alignment(spec.object_align)) { return false; }
    if (!valid_alignment(spec.slab_size)) { return false; }
    if (spec.slab_size < spec.object_size) { return false; }
    val stride: usize = align_up_usize(spec.object_size, spec.object_align);
    return stride <= spec.slab_size;
}

pub fn object_stride(spec: &ObjectCacheSpec) -> usize {
    return align_up_usize(spec.object_size, spec.object_align);
}

pub fn objects_per_slab(spec: &ObjectCacheSpec) -> usize {
    return spec.slab_size / object_stride(spec);
}

// Object-cache operations are part of the core contract even though their
// complete raw-pointer implementation is still represented by the executable
// semantic model in CForge:
//   object_cache_alloc
//   object_cache_free
//   object_cache_reclaim
//
// Primitive allocation never implicitly panics on OutOfMemory.
