module bootstrap_support;

// Minimal local-path package used to exercise Forge build graph resolution.
// It intentionally has no hosted dependencies.
pub fn identity_u32(value: u32) -> u32 {
    return value;
}

pub fn count_to(value: u32) -> u32 {
    var current: u32 = 0;
    while (current < value) {
        current = current + 1;
    }
    return current;
}

fn private_u32(value: u32) -> u32 {
    return value;
}

pub fn through_private_u32(value: u32) -> u32 {
    return private_u32(value);
}
